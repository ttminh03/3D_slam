<?xml version="1.0"?>
<robot name="amr_3d_slam">
  <!-- Prototype dimensions in metres. The ground is z=0 in base_footprint. -->
  <material name="chassis_blue"><color rgba="0.10 0.32 0.60 1"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="sensor_gray"><color rgba="0.65 0.68 0.72 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.55 0.42 0.18"/></geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision><geometry><box size="0.55 0.42 0.18"/></geometry></collision>
    <!-- Uniform 20 kg box: Ixx=m(y²+z²)/12, etc. -->
    <inertial>
      <mass value="20"/>
      <inertia ixx="0.348" ixy="0" ixz="0" iyy="0.558167" iyz="0" izz="0.798167"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.09" length="0.04"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.09" length="0.04"/></geometry>
    </collision>
    <!-- 1 kg cylinder with axle along local y. -->
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.00215833" ixy="0" ixz="0" iyy="0.00405" iyz="0" izz="0.00215833"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.235 -0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.09" length="0.04"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.09" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.00215833" ixy="0" ixz="0" iyy="0.00405" iyz="0" izz="0.00215833"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.235 -0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Fixed support balls are geometric placeholders for front and rear casters. -->
  <link name="front_caster_link">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.21 0 -0.13" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster_link">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.21 0 -0.13" rpy="0 0 0"/>
  </joint>

  <!-- Physical housing and optical origin for a future 3D LiDAR sensor. -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.06"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision><geometry><cylinder radius="0.055" length="0.08"/></geometry></collision>
    <collision>
      <origin xyz="0 0 -0.06"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.000644792" ixy="0" ixz="0" iyy="0.000644792" iyz="0" izz="0.00075625"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0 0.17" rpy="0 0 0"/>
  </joint>

  <!-- IMU frame: x forward, y left, z up; location is inside the chassis. -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision><geometry><box size="0.04 0.04 0.02"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000083333" ixy="0" ixz="0" iyy="0.0000083333" iyz="0" izz="0.0000133333"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.04 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Classic trial configuration for ROS 2 Humble. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_3d" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>25</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2617993878</min_angle>
            <max_angle>0.2617993878</max_angle>
          </vertical>
        </scan>
        <range><min>0.15</min><max>100.0</max></range>
      </ray>
      <plugin name="lidar_3d_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/points</remapping></ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>400</update_rate>
      <plugin name="imu_ros" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=/imu/data</remapping></ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Low friction approximates caster support without a rolling joint. -->
  <gazebo reference="front_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="rear_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.47</wheel_separation>
      <wheel_diameter>0.18</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
